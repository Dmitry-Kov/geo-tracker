# Copy to .env and fill in your keys. Engines enable themselves when a key is present.

# Free: https://aistudio.google.com -> Get API key (no credit card)
GEMINI_API_KEY=

# Pro subscription credits or pay-as-you-go: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Paid (cents on mini): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — override the models:
# GEMINI_MODEL=gemini-flash-latest
# PERPLEXITY_MODEL=sonar
# OPENAI_MODEL=gpt-5-mini

# White-label reports (HTML dashboard + DOCX) — optional:
# REPORT_BRAND=          # publisher/agency name on the reports (e.g. "Acme SEO"
#                        # or "agency.io"); unset = neutral "GEO Monitor" chrome,
#                        # footer "GEO Tracker" / "GEO-трекер"
# REPORT_ACCENT=#FF5C1F  # report accent color, #RRGGBB; invalid values fall
#                        # back to #FF5C1F

# Service (uvicorn app.main:app) — optional:
# APP_PASSWORD=        # set to require login; unset = local mode without auth,
#                      # served on localhost / 127.0.0.1 only
# APP_ALLOWED_HOSTS=   # comma-separated host names the service answers to,
#                      # e.g. geo.example.com (needed to serve any non-local name
#                      # without a password; recommended with one)
# APP_SECRET=          # session signing key; random per-process if unset
# APP_HTTPS_ONLY=      # 1 = session cookie gets the Secure flag (use when TLS
#                      # terminates in front of the service; browsers then
#                      # refuse to send the cookie over plain HTTP)
# GEO_DB_PATH=         # service SQLite path; default: ./geo_tracker.db
#                      # (the Docker image sets /data/geo_tracker.db itself)

# Docker deployment (docker compose up -d --build) — optional:
# APP_DOMAIN=geo.example.com   # public host name Caddy serves with automatic
#                              # HTTPS; list it in APP_ALLOWED_HOSTS too
# GEO_DATA_DIR=./data          # host directory mounted at /data in the app
#                              # container: geo_tracker.db (WAL) + backups/
#                              # when created as root on Linux:
#                              # mkdir -p data && chown 10001:10001 data
